# ===================================================
# Google Cloud Platform & Maps Configuration
# ===================================================
# Place this configuration in backend/.env:
# Enable the following APIs in your Google Cloud Console:
# 1. Places API (New)
# 2. Routes API
# 3. Cloud Translation API (optional for dynamic text translation)

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
PORT=5000
AI_BASE_URL=http://127.0.0.1:8000
